# ESP-IDF v5.4.0 s_i2c_send_commands ignores the transfer deadline after a NACK.
# Replace only that source in the SDK target with a checked, build-local patched copy.
idf_component_get_property(i2c_lib esp_driver_i2c COMPONENT_LIB)
idf_component_get_property(i2c_dir esp_driver_i2c COMPONENT_DIR)
set(i2c_original "${i2c_dir}/i2c_master.c")
set(i2c_patched "${CMAKE_CURRENT_BINARY_DIR}/i2c_master_bounded.c")
set(i2c_patcher "${CMAKE_CURRENT_LIST_DIR}/../scripts/patch_idf_i2c.py")
execute_process(COMMAND "${PYTHON}" "${i2c_patcher}" "${i2c_original}" "${i2c_patched}"
                RESULT_VARIABLE patch_result)
if(NOT patch_result EQUAL 0)
    message(FATAL_ERROR "Review the ESP-IDF I2C NACK deadline workaround")
endif()
get_target_property(i2c_sources ${i2c_lib} SOURCES)
set(i2c_replaced FALSE)
set(i2c_bounded_sources)
foreach(src IN LISTS i2c_sources)
    if(src STREQUAL "${i2c_original}")
        list(APPEND i2c_bounded_sources "${i2c_patched}")
        set(i2c_replaced TRUE)
    else()
        list(APPEND i2c_bounded_sources "${src}")
    endif()
endforeach()
if(NOT i2c_replaced)
    message(FATAL_ERROR "ESP-IDF I2C target sources changed; review deadline workaround")
endif()
set_property(TARGET ${i2c_lib} PROPERTY SOURCES "${i2c_bounded_sources}")
target_include_directories(${i2c_lib} PRIVATE "${i2c_dir}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
             "${i2c_original}" "${i2c_patcher}")
