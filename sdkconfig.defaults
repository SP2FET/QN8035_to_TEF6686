# Project defaults. The generated sdkconfig.<env> is derived from this file;
# delete it after changing values here so the new defaults take effect.
# Interactive changes: `pio run -t menuconfig` (or `idf.py menuconfig`), then
# copy the options you want to keep back into this file.

# --- Target: WEMOS/LOLIN S2 Mini (ESP32-S2FN4R2: 4 MB flash, 2 MB PSRAM) ---
CONFIG_IDF_TARGET="esp32s2"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The S2 Mini has no USB-UART bridge: console goes over native USB (CDC).
CONFIG_ESP_CONSOLE_USB_CDC=y

# --- RTOS / diagnostics ---
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
# Watchdogs reset the chip (the default only prints). The task watchdog watches the idle task
# and the radio and qn_slave tasks; a hang there (e.g. ESP-IDF 5.4.0's I2C master spinning on a
# busy bus after a NACK) otherwise leaves the tuner on its last station with Wi-Fi gone. The
# panic stores a core dump; sysmon resumes the station after the reset.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# Brown-out reset at the default 2.44 V. At 2.84 V (tried 2026-10-25) the bench board reset
# whenever a Wi-Fi client connected: the 3.3 V rail dips below 2.84 V on the radio's transmit
# bursts. That supply needs fixing; a higher level only turns the dips into resets.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# --- I2C ---
# Slave driver v2 provides on_request/on_receive callbacks, needed to emulate
# a register-mapped chip (QN8035) towards the head unit.
CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y
CONFIG_I2C_ISR_IRAM_SAFE=y

# --- Bridge hardware ---
# The fitted TEF6686 module has a 9.216 MHz crystal (verified on air: stereo
# pilot and RDS lock only with this setting).
CONFIG_BRIDGE_TEF_REFCLK_9M216=y
# The car build: the ESP answers the head unit as its QN8035. Kconfig then drops memory channels
# and CPU DFS (they conflict with the slave's timing); the web UI works as before.
CONFIG_BRIDGE_QN_EMU_ENABLE=y

# --- Wi-Fi ---
# Heap over speed. With the Wi-Fi speed-ups in IRAM (which shares the S2's SRAM with the heap)
# ~20 kB stayed free: a page load used it up, Wi-Fi could not allocate received frames, and the
# next connection failed its key handshake ("wrong password") until a reset. Moving them to
# flash gave the heap 22.6 kB (0.6.3 build); Wi-Fi's own interrupt stays in IRAM.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Abortive close (RST, frees the unsent data) for connections of a client that left: web_ui.c
CONFIG_LWIP_SO_LINGER=y

# --- Web UI ---
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- Firmware update (web OTA) ---
# A new image boots on probation; main.c confirms it after it has run for a while
# and a reset before that rolls back. Lives in the bootloader: takes effect only
# after one USB flash.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Log time stamps from the system clock (wall time once RDS clock time sets it; uptime before)
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
